# Copy to .env and adjust. Defaults below work for a local Postgres.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=sqlite to run without Postgres.
DB_ENGINE=postgres
DB_NAME=hmlet_pms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

ACCESS_TOKEN_MINUTES=60
TIME_ZONE=Asia/Singapore
